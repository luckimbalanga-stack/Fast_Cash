# Neon Postgres (pooled) — copier depuis .env.local après `neon deploy`
# Ne jamais committer les vraies valeurs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optionnel : connexion directe pour migrations / outils admin
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
